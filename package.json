{
  "name": "eregion",
  "version": "0.2.0",
  "description": "Portable pi coding workflow package with collision-safe PBT/DPBT/just-build workflows, guardrails, plan-only mode, OpenRouter models, themes, and skills.",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/eregion/index.ts",
      "./third_party/superpowers/.pi/extensions/superpowers.ts",
      "./extensions/eregion/pi-web-search.ts"
    ],
    "skills": [],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "pi-web-search": "1.7.0"
  },
  "bundleDependencies": [
    "pi-web-search"
  ]
}
