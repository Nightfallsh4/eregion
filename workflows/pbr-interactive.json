{
  "name": "pbr-interactive",
  "workflow": "pbr",
  "variant": "interactive",
  "runner": "pbr",
  "description": "Planner clarification rounds, Builder-owned TDD, and a persistent read-only review/fix loop.",
  "interactive": true,
  "models": {
    "default": "openai/gpt-5.6-terra",
    "planner": "openai/gpt-6.1-sol",
    "builder": "openai/gpt-5.6-terra",
    "reviewer": "openai/gpt-5.6-terra"
  },
  "efforts": { "default": "high" },
  "clarify": { "enabled": true, "timeout": 120000, "mode": "planner-requested-rounds" },
  "plan": { "agent": "planner-interactive", "tools": ["read", "grep", "find", "ls", "bash", "write"], "session": "persistent" },
  "build": { "agent": "builder", "tools": ["edit", "write", "read", "bash", "grep", "find", "ls"], "session": "persistent" },
  "review": { "agent": "reviewer", "tools": ["read", "bash", "grep", "find", "ls"], "session": "persistent", "planOnly": true },
  "loop": { "maxIterations": 5, "plateauDetection": true }
}
