{
  "name": "dpbr-interactive",
  "workflow": "dpbr",
  "variant": "interactive",
  "runner": "dpbr",
  "description": "Ask focused product/design questions, approve the mockup, then plan, build with TDD, and review.",
  "interactive": true,
  "models": {
    "default": "openai/gpt-5.6-terra",
    "designer": "openai/gpt-6.1-sol",
    "planner": "openai/gpt-6.1-sol",
    "builder": "openai/gpt-5.6-terra",
    "reviewer": "openai/gpt-5.6-terra"
  },
  "efforts": { "default": "high" },
  "design": { "agent": "designer", "clarify": "designer-requested-rounds", "review": "static-local-preview-with-click-annotations", "approval": "explicit" },
  "plan": { "agent": "planner-simple", "tools": ["read", "grep", "find", "ls", "bash", "write"], "session": "ephemeral" },
  "build": { "agent": "builder", "tools": ["edit", "write", "read", "bash", "grep", "find", "ls"], "session": "persistent" },
  "review": { "agent": "reviewer", "tools": ["read", "bash", "grep", "find", "ls"], "session": "persistent", "planOnly": true },
  "loop": { "maxIterations": 5, "plateauDetection": true }
}
